# termbin-ratelimit configuration -> /etc/termbin-ratelimit.env
# Copyright (C) 2026 Leproide
# Author: https://github.com/Leproide
#
# Managed by setup.py: re-running it only changes the values you edit.

# fiche log file
TB_LOG_PATH=/opt/termbin/logs/fiche.log

# fiche output directory (fiche -o); pastes are <TB_PASTE_DIR>/<slug>/
TB_PASTE_DIR=/var/www/termbin/paste

# Rate rules: max_pastes/seconds, comma separated. Exceeding ANY rule = ban.
# max 0 disables a rule (e.g. 0/600). All rules 0 = no bans at all.
TB_RULES=6/60,15/600,40/3600

# Ban duration in seconds (nft set timeout, auto-expires)
TB_BAN_TIME=86400

# Port to block for banned IPs (empty = all ports)
TB_BAN_PORT=9999

# Never banned (IP or CIDR, comma separated). Align with IPBan Whitelist.
TB_WHITELIST=127.0.0.1

# Delete the pastes created by the flood when an IP is banned (true/false).
# Removes the pastes of that IP seen within the largest active rule window.
TB_DELETE_PASTES=false

# IPThreat reporting (empty key = disabled)
TB_IPTHREAT_KEY=
# Names or integer bitmask: Dns,Fraud,DDos,BruteForce,Proxy,Spam,Vpn,Hacking,
# BadBot,Compromised,Phishing,Iot,PortScan,AI
TB_IPTHREAT_FLAGS=DDos,Spam
TB_IPTHREAT_SYSTEM=Termbin

# Dedicated nftables table (inet family)
TB_NFT_TABLE=termbin_ratelimit

# 1 = log violations only, no ban, no report, no delete
TB_DRY_RUN=0
